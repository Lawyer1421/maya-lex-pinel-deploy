# ══════════════════════════════════════════════════════════════
# Maya Lex IA — Variables de entorno (plantilla)
# Copia este archivo como .env.local y rellena los valores reales.
# NUNCA comitas .env.local al repositorio.
# ══════════════════════════════════════════════════════════════

# ── IA Principal ───────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── OpenRouter (multimodel — opcional) ────────────────────────
OPENROUTER_API_KEY=
# 'anthropic' (default) | 'openrouter' (experimental)
LLM_PROVIDER=anthropic

# ── Búsqueda web (Tavily) ──────────────────────────────────────
# Obtener en: https://app.tavily.com → API Keys
# Si vacío: webSearch usa fallback a RAG local
TAVILY_API_KEY=

# ── RAG Backend ────────────────────────────────────────────────
# 'disabled' | 'python' (FastAPI local) | 'supabase'
RAG_BACKEND=python
PYTHON_RAG_URL=http://localhost:8100

# ── Cohere Rerank (Etapa 2 del retrieval en dos etapas) ────────
# Obtener en: https://dashboard.cohere.com → API Keys
# Modelo: rerank-v3.5. Si vacío: se mantiene el orden por similitud
# pgvector de la Etapa 1 (degradación elegante, ver lib/rag/rerank.ts).
# Solo en Vercel/entorno local — nunca commitear el valor real.
# Gate previsto: flag_rerank (feature_flags) — ver docs/runbooks/cohere-rerank-flag.md
COHERE_API_KEY=

# ── Supabase (base de datos + analytics + auth) ────────────────
# Obtener en: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Supabase PostgreSQL — requerido para npm run migrate:analytics
# Obtener en: Supabase Dashboard → Settings → Database → URI
# Formato: postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres
DATABASE_URL=

# ── PayPal (Subscriptions API) ────────────────────────────────
# Docs: https://developer.paypal.com/dashboard/ → My Apps & Credentials
# 'sandbox' | 'live'
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_PRO_PLAN_ID=
PAYPAL_ACADEMICO_PLAN_ID=
PAYPAL_WEBHOOK_ID=
# DEV ONLY: NUNCA true en producción (PAYPAL_MODE=live)
PAYPAL_DEV_BYPASS_VERIFY=false

# ── General ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEBUG_CLAUDE=false

# ── Modelos Anthropic (opcionales) ─────────────────────────────
# Sin estas vars la app usa Sonnet 4.6 (análisis/documento) y Haiku 4.5 (sala).
# Allowlist: claude-sonnet-4-6 | claude-haiku-4-5
# Opus en env se ignora (cae al default del modo). Vacío/inválido → default.
# Haiku no lleva thinking adaptive (Anthropic 400 si se envía).
# MAYA_MODEL_ANALISIS=
# MAYA_MODEL_DOCUMENTO=
# MAYA_MODEL_ANALISIS_PENAL=
# MAYA_MODEL_ESCRITOS_PENALES=
# MAYA_MODEL_SALA_IA=
# MAYA_MODEL_SALA_PENAL=
# MAYA_HISTORY_TURNS=10

# ── Rate Limiting ──────────────────────────────────────────────
FREE_TIER_DAILY_LIMIT=3
PRO_TIER_DAILY_LIMIT=100
# Cuota diaria de la bolsa MCP (identificador mcp:email:...), sólo tier pro.
# MCP v1 aún no tiene ruta; flag_mcp_enabled sigue OFF (sin fila en feature_flags).
MCP_TIER_DAILY_LIMIT=200
