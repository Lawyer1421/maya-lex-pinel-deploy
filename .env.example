# Copy to .env (never commit .env). Every value here is a safe default.

# --- Network: loopback only by default ---
FPW_HOST=127.0.0.1
FPW_PORT=3000

# --- Data-locality policy ---
# EXTERNAL providers are OFF unless this is true AND the provider is allow-listed
# AND each request is approved by the human in the UI.
FPW_ALLOW_EXTERNAL=false
FPW_EXTERNAL_ALLOWLIST=
# Local-model server (Ollama). Must resolve to loopback/private unless overridden.
FPW_OLLAMA_URL=http://127.0.0.1:11434
FPW_OLLAMA_MODEL=llama3.1
FPW_DEFAULT_PROVIDER=echo

# --- Paths ---
FPW_AUDIT_FILE=storage/audit/audit.jsonl

# --- Optional, only used by EXTERNAL adapters (leave empty) ---
ANTHROPIC_API_KEY=

# --- Local database (docker/docker-compose.yml) ---
POSTGRES_PASSWORD=change-me-locally
